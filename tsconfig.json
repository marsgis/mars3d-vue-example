{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "strictFunctionTypes": true, // 模块 08 开启（C023）：全仓仅 1 处示例回调签名需修正
    "strictNullChecks": false, // 维持关闭：全仓 157 处诊断（示例 90 / 公共层 67），见问题台账 I042
    "jsx": "preserve",
    "allowJs": true,
    "sourceMap": true,
    "alwaysStrict": true,
    "noImplicitAny": false, // 维持关闭：全仓 420 处诊断（示例 226 / 公共层 194），见问题台账 I042
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "lib": ["esnext", "dom", "dom.iterable", "scripthost"],
    "isolatedModules": false,
    "types": ["node"],
    "paths": {
      "@mars/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["node_modules", "src/**/*.js", "dist"]
}
